      "parameters": {
        "content": "## L5b · Cleanup after a test run\nDeletes (archives) every HubSpot contact the stress test created, using the `cid:` IDs saved in **TestReport**.\nHubSpot keeps archived contacts restorable for 90 days.\n\nAfterwards, clear the test rows from **Events** and **TestReport** by hand (keep row 1, the headers).",
        "height": 300,
        "width": 620,
        "color": 3
      },
      "id": "adc92e11-ff58-4dec-b379-c09675f7a6e7",
      "name": "Note e76fe7",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -352,
        -176
      ]
    },
    {
      "parameters": {},
      "id": "25807332-9f30-4c1b-91dc-ccfbd379d17a",
      "name": "Run cleanup",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -288,
        192
      ]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "documentId": {
          "__rl": true,
          "value": "PASTE_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
